<Project>
  <PropertyGroup>
    <!-- CI overrides this from the release tag: dotnet publish -p:Version=1.2.3 -->
    <Version>1.1.0</Version>
    <Product>AppBridge</Product>
    <Company>AppBridge contributors</Company>
    <Authors>AppBridge contributors</Authors>
    <Copyright>Copyright (c) 2026 AppBridge contributors</Copyright>
    <RepositoryUrl>https://github.com/kr0nsch/AppBridge</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
