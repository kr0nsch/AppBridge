<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AppBridge.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppBridge.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Netimobiledevice" Version="2.5.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Netimobiledevice only needs WinTun for network tunnels, which AppBridge never uses.
         Its package declares no license, so its files are kept out of the build output. -->
    <PackageReference Include="Unofficial.WinTun" Version="0.14.1.3" ExcludeAssets="all" />
  </ItemGroup>

</Project>
