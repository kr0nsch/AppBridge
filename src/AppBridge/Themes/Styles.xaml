<?xml version="1.0" encoding="utf-8"?>
<!--
  AppBridge design system: Apple-inspired palette (iOS system colors), generous spacing,
  pill buttons, inset grouped lists and circular checkmarks. Built-in WinUI controls pick up
  the Apple blue accent through the SystemAccentColor overrides below.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="SystemAccentColor">#FF007AFF</Color>
      <Color x:Key="SystemAccentColorLight1">#FF3395FF</Color>
      <Color x:Key="SystemAccentColorLight2">#FF4DA3FF</Color>
      <Color x:Key="SystemAccentColorLight3">#FF80BDFF</Color>
      <Color x:Key="SystemAccentColorDark1">#FF007AFF</Color>
      <Color x:Key="SystemAccentColorDark2">#FF0066DB</Color>
      <Color x:Key="SystemAccentColorDark3">#FF0052B0</Color>

      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF5F5F7" />
      <LinearGradientBrush x:Key="DeviceIconBrush" StartPoint="0.15,0" EndPoint="0.85,1">
        <GradientStop Offset="0" Color="#FF0096DC" />
        <GradientStop Offset="1" Color="#FF3C46E6" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="BackgroundGlowBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.6">
        <GradientStop Offset="0" Color="#1A007AFF" />
        <GradientStop Offset="0.6" Color="#08007AFF" />
        <GradientStop Offset="1" Color="#00007AFF" />
      </RadialGradientBrush>

      <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#12000000" />
      <SolidColorBrush x:Key="AppSeparatorBrush" Color="#243C3C43" />
      <SolidColorBrush x:Key="AppLabelBrush" Color="#FF1D1D1F" />
      <SolidColorBrush x:Key="AppSecondaryLabelBrush" Color="#FF6E6E73" />
      <SolidColorBrush x:Key="AppTertiaryLabelBrush" Color="#FFAEAEB2" />
      <SolidColorBrush x:Key="AppFillBrush" Color="#1F767680" />
      <SolidColorBrush x:Key="AppBlueBrush" Color="#FF007AFF" />
      <SolidColorBrush x:Key="AppBlueTintBrush" Color="#14007AFF" />
      <SolidColorBrush x:Key="AppGreenBrush" Color="#FF34C759" />
      <SolidColorBrush x:Key="AppRedBrush" Color="#FFFF3B30" />
      <SolidColorBrush x:Key="AppOrangeBrush" Color="#FFFF9500" />
      <SolidColorBrush x:Key="AppIconPlaceholderBrush" Color="#FFE5E5EA" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SegmentSelectedStrokeBrush" Color="#14000000" />

      <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF34C759" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF30B852" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF2AA64A" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF34C759" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF30B852" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF2AA64A" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SystemAccentColor">#FF0A84FF</Color>
      <Color x:Key="SystemAccentColorLight1">#FF0A84FF</Color>
      <Color x:Key="SystemAccentColorLight2">#FF0A84FF</Color>
      <Color x:Key="SystemAccentColorLight3">#FF5EADFF</Color>
      <Color x:Key="SystemAccentColorDark1">#FF0A84FF</Color>
      <Color x:Key="SystemAccentColorDark2">#FF0070DB</Color>
      <Color x:Key="SystemAccentColorDark3">#FF005CB3</Color>

      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0B0B0C" />
      <LinearGradientBrush x:Key="DeviceIconBrush" StartPoint="0.15,0" EndPoint="0.85,1">
        <GradientStop Offset="0" Color="#FF0096DC" />
        <GradientStop Offset="1" Color="#FF3C46E6" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="BackgroundGlowBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.6">
        <GradientStop Offset="0" Color="#2E0A84FF" />
        <GradientStop Offset="0.6" Color="#0D5C40E0" />
        <GradientStop Offset="1" Color="#000A84FF" />
      </RadialGradientBrush>

      <SolidColorBrush x:Key="AppCardBrush" Color="#FF1C1C1E" />
      <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="AppSeparatorBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="AppLabelBrush" Color="#FFF5F5F7" />
      <SolidColorBrush x:Key="AppSecondaryLabelBrush" Color="#FF98989D" />
      <SolidColorBrush x:Key="AppTertiaryLabelBrush" Color="#FF636366" />
      <SolidColorBrush x:Key="AppFillBrush" Color="#3D767680" />
      <SolidColorBrush x:Key="AppBlueBrush" Color="#FF0A84FF" />
      <SolidColorBrush x:Key="AppBlueTintBrush" Color="#260A84FF" />
      <SolidColorBrush x:Key="AppGreenBrush" Color="#FF30D158" />
      <SolidColorBrush x:Key="AppRedBrush" Color="#FFFF453A" />
      <SolidColorBrush x:Key="AppOrangeBrush" Color="#FFFF9F0A" />
      <SolidColorBrush x:Key="AppIconPlaceholderBrush" Color="#FF3A3A3C" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF636366" />
      <SolidColorBrush x:Key="SegmentSelectedStrokeBrush" Color="#00000000" />

      <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF30D158" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF3ADB62" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF28B84B" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF30D158" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF3ADB62" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF28B84B" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="DeviceIconBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="BackgroundGlowBrush" Color="Transparent" />

      <SolidColorBrush x:Key="AppCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AppCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppSecondaryLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppTertiaryLabelBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AppFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AppBlueBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="AppBlueTintBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AppGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppRedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppOrangeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppIconPlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SegmentSelectedStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <CornerRadius x:Key="GroupCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="AppIconCornerRadius">9</CornerRadius>



  <!-- Typography -->
  <Style x:Key="LargeTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-12" />
    <Setter Property="Foreground" Value="{ThemeResource AppLabelBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="HeroSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{ThemeResource AppSecondaryLabelBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style x:Key="RowTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AppLabelBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="RowBodyStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource AppLabelBrush}" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource AppSecondaryLabelBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <Style x:Key="FootnoteStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Foreground" Value="{ThemeResource AppSecondaryLabelBrush}" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AppSecondaryLabelBrush}" />
    <Setter Property="Margin" Value="16,18,16,6" />
    <Setter Property="CharacterSpacing" Value="40" />
  </Style>

  <!-- Containers -->
  <Style x:Key="GroupCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource GroupCornerRadius}" />
  </Style>

  <Style x:Key="PillStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{ThemeResource AppFillBrush}" />
  </Style>

  <Style x:Key="SeparatorStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{ThemeResource AppSeparatorBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Rows inside a GroupCard: inset rounded highlight like macOS lists. -->
  <Style x:Key="InsetRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Rounded, slightly thicker progress bars on a light track, as on iOS. -->
  <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{ThemeResource AppFillBrush}" />
  </Style>

  <!-- Rows that draw their own padding (so a selection tint can fill the whole row). -->
  <Style x:Key="FlushRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource InsetRowItemStyle}">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Buttons -->
  <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Padding" Value="28,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
  </Style>

  <Style x:Key="SecondaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource AppBlueBrush}" />
  </Style>

  <Style x:Key="DestructivePillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryPillButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AppRedBrush}" />
    <Setter Property="MinWidth" Value="220" />
  </Style>

  <Style x:Key="SmallPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AppBlueBrush}" />
  </Style>

  <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <!-- Circular checkmark, as in iOS selection lists. -->
  <Style x:Key="CircleCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Width="24" Height="24" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CombinedStates">
                <VisualState x:Name="UncheckedNormal" />
                <VisualState x:Name="UncheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource AppSecondaryLabelBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UncheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource AppSecondaryLabelBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UncheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedNormal">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="1" />
                    <Setter Target="Glyph.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="0.9" />
                    <Setter Target="Glyph.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="0.8" />
                    <Setter Target="Glyph.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Fill.Opacity" Value="1" />
                    <Setter Target="Glyph.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Ellipse x:Name="Ring" Width="22" Height="22" StrokeThickness="1.5" Stroke="{ThemeResource AppTertiaryLabelBrush}" />
            <Ellipse x:Name="Fill" Width="22" Height="22" Fill="{ThemeResource AppBlueBrush}" Opacity="0" />
            <FontIcon x:Name="Glyph" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One segment of an iOS-style segmented control (place RadioButtons in a SegmentedHost border). -->
  <Style x:Key="SegmentedHostStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AppFillBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AppLabelBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" MinHeight="28">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Pill.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Pill" Opacity="0" CornerRadius="7"
                    Background="{ThemeResource SegmentSelectedBrush}"
                    BorderBrush="{ThemeResource SegmentSelectedStrokeBrush}" BorderThickness="0.5" />
            <ContentPresenter Margin="12,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextWrapping="NoWrap" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text fields inside grouped forms: borderless, label on the left. -->
  <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="0,9,0,9" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="0,9,0,9" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{ThemeResource AppFillBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="34,7,10,7" />
    <Setter Property="FontSize" Value="14" />
  </Style>
</ResourceDictionary>
