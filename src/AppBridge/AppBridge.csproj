<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AppBridge</RootNamespace>
    <AssemblyName>AppBridge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppBridge.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged, fully self-contained: runs from a folder without installing any runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- System.Reactive (via Netimobiledevice > Zeroconf) would otherwise drag WPF and
         Windows Forms into the self-contained output. Nothing here uses them. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- The same package also references WPF's WindowsBase; the runtime facade satisfies it. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- Program.cs provides Main so it can enforce a single instance before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Partial trimming only touches assemblies that declare themselves trim-safe (the .NET
         libraries and Windows projections). All UI bindings are compiled x:Bind. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never trim the device stack: its USB code paths can't be exercised in CI. -->
    <TrimmerRootAssembly Include="AppBridge.Core" />
    <TrimmerRootAssembly Include="Netimobiledevice" />
    <TrimmerRootAssembly Include="Zeroconf" />
    <TrimmerRootAssembly Include="System.Reactive" />
  </ItemGroup>

  <!-- ipatool is downloaded and checksum-verified by build\Get-Ipatool.ps1 (never committed). -->
  <PropertyGroup>
    <IpatoolRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</IpatoolRid>
    <IpatoolRid Condition="'$(IpatoolRid)' == '' and '$(Platform)' == 'ARM64'">win-arm64</IpatoolRid>
    <IpatoolRid Condition="'$(IpatoolRid)' == ''">win-x64</IpatoolRid>
    <IpatoolPath Condition="'$(IpatoolPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\tools\$(IpatoolRid)\ipatool.exe</IpatoolPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(IpatoolPath)" Condition="Exists('$(IpatoolPath)')" Link="tools\ipatool.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingIpatool" BeforeTargets="Build" Condition="!Exists('$(IpatoolPath)')">
    <Warning Text="ipatool not found at $(IpatoolPath). Run build\Get-Ipatool.ps1 -RuntimeIdentifier $(IpatoolRid) so the app can download apps." />
  </Target>

  <ItemGroup>
    <!-- Windows App SDK components only (the metapackage would also ship AI/ML runtimes). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppBridge.Core\AppBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Netimobiledevice only needs WinTun for network tunnels, which AppBridge never uses.
         Its package declares no license, so its files are kept out of the build output. -->
    <PackageReference Include="Unofficial.WinTun" Version="0.14.1.3" ExcludeAssets="all" />
  </ItemGroup>

</Project>
