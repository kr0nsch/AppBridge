<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AppBridge.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="Settings_Dialog"
    Title="Settings"
    CloseButtonText="Done"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

  <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Margin="0,0,-12,0">
    <StackPanel Width="440">

      <TextBlock x:Uid="Settings_General" Style="{StaticResource SectionHeaderStyle}" Margin="16,4,16,6" Text="GENERAL" />
      <Border Style="{StaticResource GroupCardStyle}" Padding="16,0">
        <StackPanel>
          <Grid MinHeight="48" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Settings_Language" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Language" />
            <ComboBox x:Name="LanguageBox" x:Uid="Settings_LanguageBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged" />
          </Grid>
          <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
          <Grid MinHeight="48" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Settings_Appearance" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Appearance" />
            <Border Grid.Column="1" Style="{StaticResource SegmentedHostStyle}" VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ThemeSystem" x:Uid="Settings_ThemeSystem" GroupName="Theme" Style="{StaticResource SegmentRadioButtonStyle}"
                             Content="Auto" Checked="OnThemeChecked" />
                <RadioButton x:Name="ThemeLight" x:Uid="Settings_ThemeLight" Grid.Column="1" GroupName="Theme" Style="{StaticResource SegmentRadioButtonStyle}"
                             Content="Light" Checked="OnThemeChecked" />
                <RadioButton x:Name="ThemeDark" x:Uid="Settings_ThemeDark" Grid.Column="2" GroupName="Theme" Style="{StaticResource SegmentRadioButtonStyle}"
                             Content="Dark" Checked="OnThemeChecked" />
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </Border>
      <Grid x:Name="RestartPanel" Visibility="Collapsed" Margin="16,8,16,0" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Uid="Settings_RestartHint" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center" Text="Restart AppBridge to switch the language." />
        <Button x:Uid="Settings_Restart" Grid.Column="1" Style="{StaticResource SmallPillButtonStyle}" Content="Restart" Click="OnRestartClick" />
      </Grid>

      <TextBlock x:Uid="Settings_Downloads" Style="{StaticResource SectionHeaderStyle}" Text="DOWNLOADS" />
      <Border Style="{StaticResource GroupCardStyle}" Padding="16,0">
        <StackPanel>
          <Grid MinHeight="56" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Padding="0,8">
              <TextBlock x:Uid="Settings_Folder" Style="{StaticResource RowBodyStyle}" Text="Folder" />
              <TextBlock x:Name="FolderText" Style="{StaticResource FootnoteStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Uid="Settings_Open" Style="{StaticResource SmallPillButtonStyle}" Content="Open" Click="OnOpenFolderClick" />
              <Button x:Uid="Settings_Change" Style="{StaticResource SmallPillButtonStyle}" Content="Change…" Click="OnChangeFolderClick" />
            </StackPanel>
          </Grid>
          <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
          <Grid MinHeight="48" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Options_Keep" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Keep downloaded files" />
            <ToggleSwitch x:Name="KeepToggle" x:Uid="Options_KeepToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="OnKeepToggled" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_About" Style="{StaticResource SectionHeaderStyle}" Text="ABOUT" />
      <Border Style="{StaticResource GroupCardStyle}" Padding="16,0">
        <StackPanel>
          <Grid MinHeight="44">
            <TextBlock x:Uid="Settings_Version" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Version" />
            <TextBlock x:Name="VersionText" Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
          <Grid MinHeight="44">
            <TextBlock x:Uid="Settings_Source" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Source code" />
            <HyperlinkButton HorizontalAlignment="Right" Padding="6,4" Content="GitHub" Click="OnGitHubClick" />
          </Grid>
          <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
          <Grid MinHeight="44">
            <TextBlock x:Uid="Settings_Licenses" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Open-source licenses" />
            <HyperlinkButton x:Uid="Settings_View" HorizontalAlignment="Right" Padding="6,4" Content="View" Click="OnLicensesClick" />
          </Grid>
          <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
          <Grid MinHeight="44">
            <TextBlock x:Uid="Settings_Logs" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Diagnostic logs" />
            <HyperlinkButton x:Uid="Settings_OpenLogs" HorizontalAlignment="Right" Padding="6,4" Content="Show" Click="OnLogsClick" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock x:Uid="Settings_Disclaimer" Style="{StaticResource FootnoteStyle}" Margin="16,10,16,4"
                 Text="AppBridge is free, open-source software. It is not affiliated with or endorsed by Apple Inc. iPhone and App Store are trademarks of Apple Inc." />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
