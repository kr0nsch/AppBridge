<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppBridge.Views.AppsStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppBridge.ViewModels">

  <UserControl.Resources>
    <!-- The search field stays a soft grey capsule when hovered or focused. -->
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#26767680" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#26767680" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
  </UserControl.Resources>

  <Grid MaxWidth="680" Padding="24,4,24,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Uid="Apps_Title" Style="{StaticResource LargeTitleStyle}" Text="Choose Apps" />
      <TextBlock Style="{StaticResource HeroSubtitleStyle}" Text="{x:Bind ViewModel.AppsSubtitle, Mode=OneWay}" />
    </StackPanel>

    <!-- Search and select all -->
    <Grid Grid.Row="1" Margin="0,22,0,12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.Apps.ShowList, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Uid="Apps_Search" Style="{StaticResource SearchBoxStyle}" PlaceholderText="Search"
               Text="{x:Bind ViewModel.Apps.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
      <HyperlinkButton Grid.Column="1" Content="{x:Bind ViewModel.Apps.SelectAllText, Mode=OneWay}"
                       Command="{x:Bind ViewModel.Apps.ToggleSelectAllCommand}" FontWeight="SemiBold" />
    </Grid>

    <!-- Loading -->
    <StackPanel Grid.Row="2" Visibility="{x:Bind ViewModel.Apps.IsLoading, Mode=OneWay}" VerticalAlignment="Center" Spacing="14">
      <ProgressRing IsActive="{x:Bind ViewModel.Apps.IsLoading, Mode=OneWay}" Width="32" Height="32" />
      <TextBlock x:Uid="Apps_Loading" Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                 HorizontalAlignment="Center" Text="Reading apps from your iPhone…" />
    </StackPanel>

    <!-- Error -->
    <StackPanel Grid.Row="2" Visibility="{x:Bind ViewModel.Apps.HasError, Mode=OneWay}" VerticalAlignment="Center" Spacing="14" Margin="0,24,0,0">
      <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource AppOrangeBrush}" />
      <TextBlock Style="{StaticResource RowBodyStyle}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                 Text="{x:Bind ViewModel.Apps.Error, Mode=OneWay}" />
      <Button x:Uid="Apps_TryAgain" Style="{StaticResource SmallPillButtonStyle}" HorizontalAlignment="Center" Content="Try Again"
              Command="{x:Bind ViewModel.RetryAppsCommand}" />
    </StackPanel>

    <!-- No App Store apps -->
    <StackPanel Grid.Row="2" Visibility="{x:Bind ViewModel.Apps.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center" Spacing="10" Margin="0,24,0,0">
      <FontIcon Glyph="&#xE71D;" FontSize="32" Foreground="{ThemeResource AppTertiaryLabelBrush}" />
      <TextBlock x:Uid="Apps_Empty" Style="{StaticResource RowBodyStyle}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                 Foreground="{ThemeResource AppSecondaryLabelBrush}" Text="No apps from the App Store were found on this iPhone." />
    </StackPanel>

    <!-- App list -->
    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}" Padding="0,4" Visibility="{x:Bind ViewModel.Apps.ShowList, Mode=OneWay}">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Apps.Visible}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppClick"
                  ItemContainerStyle="{StaticResource InsetRowItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:AppItemViewModel">
              <Grid MinHeight="60">
                <Rectangle Style="{StaticResource SeparatorStyle}" Margin="92,0,-12,0" Visibility="{x:Bind ShowSeparator, Mode=OneWay}" />
                <Grid ColumnSpacing="14" Padding="0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource CircleCheckBoxStyle}" VerticalAlignment="Center"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" />
                  <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource AppIconCornerRadius}" Background="{ThemeResource AppIconPlaceholderBrush}" />
                    <TextBlock Text="{x:Bind Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowInitial, Mode=OneWay}" />
                    <Border CornerRadius="{StaticResource AppIconCornerRadius}" Visibility="{x:Bind HasIcon, Mode=OneWay}">
                      <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                    <Border CornerRadius="{StaticResource AppIconCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource AppCardStrokeBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Uid="Apps_NoMatches" Visibility="{x:Bind ViewModel.Apps.ShowNoMatches, Mode=OneWay}" Style="{StaticResource RowBodyStyle}"
                   Foreground="{ThemeResource AppSecondaryLabelBrush}" HorizontalAlignment="Center" Margin="0,28" Text="No matching apps" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Style="{StaticResource FootnoteStyle}" Margin="16,10,16,0" TextAlignment="Center"
               Visibility="{x:Bind ViewModel.Apps.HasNotFromStore, Mode=OneWay}" Text="{x:Bind ViewModel.Apps.NotFromStoreText, Mode=OneWay}" />
  </Grid>
</UserControl>
