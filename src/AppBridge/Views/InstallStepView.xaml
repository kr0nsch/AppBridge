<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppBridge.Views.InstallStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppBridge.ViewModels"
    xmlns:views="using:AppBridge.Views"
    xmlns:controls="using:AppBridge.Controls">

  <Grid MaxWidth="640" Padding="24,4,24,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Hero -->
    <StackPanel>
      <controls:HeroBadge x:Name="Hero" HorizontalAlignment="Center" Margin="0,0,0,10"
                          Glyph="{x:Bind ViewModel.InstallGlyph, Mode=OneWay}"
                          Tone="{x:Bind ViewModel.InstallTone, Mode=OneWay}"
                          Progress="{x:Bind ViewModel.InstallRingProgress, Mode=OneWay}" />
      <TextBlock Style="{StaticResource LargeTitleStyle}" Text="{x:Bind ViewModel.InstallTitle, Mode=OneWay}" />
      <TextBlock Style="{StaticResource HeroSubtitleStyle}" Text="{x:Bind ViewModel.InstallSubtitle, Mode=OneWay}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  Visibility="{x:Bind views:Ui.Collapsed(ViewModel.Install.ShowItems), Mode=OneWay}">
      <StackPanel Padding="0,0,0,12">

        <views:SignInPanel Account="{x:Bind ViewModel.Account}" Visibility="{x:Bind ViewModel.ShowSignInPanel, Mode=OneWay}" />

        <StackPanel Visibility="{x:Bind ViewModel.ShowInstallSummary, Mode=OneWay}">
          <!-- Summary -->
          <Border Style="{StaticResource GroupCardStyle}" Padding="16,0">
            <StackPanel>
              <Grid MinHeight="44">
                <TextBlock x:Uid="Summary_From" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="From" />
                <TextBlock Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="{x:Bind ViewModel.SummaryFrom, Mode=OneWay}" />
              </Grid>
              <StackPanel Visibility="{x:Bind ViewModel.ShowSummaryTo, Mode=OneWay}">
                <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
                <Grid MinHeight="44">
                  <TextBlock x:Uid="Summary_To" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="To" />
                  <TextBlock Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Text="{x:Bind ViewModel.SummaryTo, Mode=OneWay}" />
                </Grid>
              </StackPanel>
              <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
              <Grid MinHeight="44">
                <TextBlock x:Uid="Summary_Apps" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Apps" />
                <TextBlock Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="{x:Bind ViewModel.SummaryApps, Mode=OneWay}" />
              </Grid>
              <StackPanel Visibility="{x:Bind ViewModel.ShowSummaryFolder, Mode=OneWay}">
                <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
                <Grid MinHeight="44" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Uid="Summary_Folder" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Folder" />
                  <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Padding="6,4" Margin="0,0,-6,0" Command="{x:Bind ViewModel.OpenFolderCommand}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.Library.Folder, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FolderDisplay, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </HyperlinkButton>
                </Grid>
              </StackPanel>
              <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
              <Grid MinHeight="44" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="Summary_Account" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Apple Account" />
                <TextBlock Grid.Column="1" Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Text="{x:Bind ViewModel.SummaryAccount, Mode=OneWay}" />
                <HyperlinkButton x:Uid="Summary_SignOut" Grid.Column="2" Padding="6,4" Content="Sign Out"
                                 Visibility="{x:Bind ViewModel.ShowSignOut, Mode=OneWay}" Command="{x:Bind ViewModel.Account.SignOutCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Options -->
          <TextBlock x:Uid="Options_Header" Style="{StaticResource SectionHeaderStyle}" Text="OPTIONS"
                     Visibility="{x:Bind ViewModel.ShowOptions, Mode=OneWay}" />
          <Border Style="{StaticResource GroupCardStyle}" Padding="16,0" Visibility="{x:Bind ViewModel.ShowOptions, Mode=OneWay}">
            <StackPanel>
              <Grid MinHeight="52" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="Options_Version" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Version" />
                <Border Grid.Column="1" Style="{StaticResource SegmentedHostStyle}" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Uid="Options_VersionLatest" GroupName="VersionPolicy" Style="{StaticResource SegmentRadioButtonStyle}" Content="Latest"
                                 IsChecked="{x:Bind ViewModel.Install.UseLatestVersion, Mode=TwoWay}" />
                    <RadioButton x:Uid="Options_VersionSame" Grid.Column="1" GroupName="VersionPolicy" Style="{StaticResource SegmentRadioButtonStyle}"
                                 Content="Same as old iPhone" IsChecked="{x:Bind ViewModel.Install.UseSourceVersion, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </Grid>
              <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" />
              <Grid MinHeight="52" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Padding="0,8">
                  <TextBlock x:Uid="Options_Free" Style="{StaticResource RowBodyStyle}" Text="Get free apps you don't own yet" />
                  <TextBlock x:Uid="Options_FreeHint" Style="{StaticResource FootnoteStyle}" Text="Adds them to your Apple Account, just like tapping Get in the App Store." />
                </StackPanel>
                <ToggleSwitch x:Uid="Options_FreeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              IsOn="{x:Bind ViewModel.Install.AcquireFreeLicenses, Mode=TwoWay}" />
              </Grid>
              <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,0,-16,0" Visibility="{x:Bind ViewModel.ShowKeepOption, Mode=OneWay}" />
              <Grid MinHeight="52" ColumnSpacing="16" Visibility="{x:Bind ViewModel.ShowKeepOption, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Padding="0,8">
                  <TextBlock x:Uid="Options_Keep" Style="{StaticResource RowBodyStyle}" Text="Keep downloaded files" />
                  <TextBlock x:Uid="Options_KeepHint" Style="{StaticResource FootnoteStyle}" Text="Saves the .ipa files so you can install them again later." />
                </StackPanel>
                <ToggleSwitch x:Uid="Options_KeepToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              IsOn="{x:Bind ViewModel.Install.KeepDownloads, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource FootnoteStyle}" Margin="16,8,16,0" Text="{x:Bind ViewModel.InstallFootnote, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Progress list, with what to do next once the run is over -->
    <Grid Grid.Row="1" Margin="0,22,0,0" RowSpacing="16" Visibility="{x:Bind ViewModel.Install.ShowItems, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Visibility="{x:Bind ViewModel.ShowSaveDoneCard, Mode=OneWay}">
        <TextBlock x:Uid="SaveDone_Header" Style="{StaticResource SectionHeaderStyle}" Margin="16,0,16,6" Text="WHEN YOUR NEW IPHONE ARRIVES" />
        <Border Style="{StaticResource GroupCardStyle}" Padding="16,2">
          <StackPanel>
            <Grid MinHeight="44" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="22" Height="22" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource AppBlueBrush}" />
                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.SaveDoneStep1, Mode=OneWay}" />
            </Grid>
            <Rectangle Style="{StaticResource SeparatorStyle}" Margin="34,0,-16,0" />
            <Grid MinHeight="44" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="22" Height="22" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource AppBlueBrush}" />
                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Uid="SaveDone_Step2" Grid.Column="1" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center" Text="Connect it and open AppBridge." />
            </Grid>
            <Rectangle Style="{StaticResource SeparatorStyle}" Margin="34,0,-16,0" />
            <Grid MinHeight="44" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="22" Height="22" VerticalAlignment="Center">
                <Ellipse Fill="{ThemeResource AppBlueBrush}" />
                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Uid="SaveDone_Step3" Grid.Column="1" Style="{StaticResource RowBodyStyle}" VerticalAlignment="Center"
                         Text="Choose Transfer Later → Install on New iPhone." />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource FootnoteStyle}" Margin="16,8,16,0" Text="{x:Bind ViewModel.SaveDoneFootnote, Mode=OneWay}" />
      </StackPanel>

      <Border Style="{StaticResource GroupCardStyle}" Padding="16,12" Visibility="{x:Bind ViewModel.ShowAccountCard, Mode=OneWay}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AppSecondaryLabelBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Grid.Column="1" Style="{StaticResource FootnoteStyle}" FontSize="13" LineHeight="18" Text="{x:Bind ViewModel.AccountCardText, Mode=OneWay}" />
        </Grid>
      </Border>

    <Border Grid.Row="1" Style="{StaticResource GroupCardStyle}" Padding="0,4">
      <ListView ItemsSource="{x:Bind ViewModel.Install.Items}" SelectionMode="None" ItemContainerStyle="{StaticResource InsetRowItemStyle}">
        <ListView.ItemContainerTransitions>
          <TransitionCollection>
            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
          </TransitionCollection>
        </ListView.ItemContainerTransitions>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:TransferItemViewModel">
            <Grid MinHeight="60">
              <Rectangle Style="{StaticResource SeparatorStyle}" Margin="54,0,-12,0" Visibility="{x:Bind ShowSeparator, Mode=OneWay}" />
              <Grid ColumnSpacing="14" Padding="0,9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                  <Border CornerRadius="{StaticResource AppIconCornerRadius}" Background="{ThemeResource AppIconPlaceholderBrush}" />
                  <TextBlock Text="{x:Bind Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowInitial}" />
                  <Border CornerRadius="{StaticResource AppIconCornerRadius}" Visibility="{x:Bind HasIcon}">
                    <Border.Background>
                      <ImageBrush ImageSource="{x:Bind Icon}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                  <Border CornerRadius="{StaticResource AppIconCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource AppCardStrokeBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Style="{StaticResource RowTitleStyle}" Text="{x:Bind Name}" />
                  <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind StatusText, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
                  <ProgressBar Margin="0,5,0,0" Maximum="100" Value="{x:Bind ProgressValue, Mode=OneWay}"
                               IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Column="2" Width="24" VerticalAlignment="Center">
                  <Grid Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                    <Ellipse Width="22" Height="22" Fill="{ThemeResource AppGreenBrush}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="White" />
                  </Grid>
                  <Grid Visibility="{x:Bind IsFailed, Mode=OneWay}">
                    <Ellipse Width="22" Height="22" Fill="{ThemeResource AppRedBrush}" />
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" FontWeight="Bold" Foreground="White" />
                  </Grid>
                  <Ellipse Width="20" Height="20" StrokeThickness="1.5" Stroke="{ThemeResource AppTertiaryLabelBrush}"
                           Visibility="{x:Bind IsWaiting, Mode=OneWay}" />
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>
    </Grid>
  </Grid>
</UserControl>
