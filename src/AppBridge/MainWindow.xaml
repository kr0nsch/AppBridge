<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AppBridge">

  <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Soft brand glow behind everything. -->
    <Rectangle Grid.RowSpan="5" IsHitTestVisible="False" Fill="{ThemeResource BackgroundGlowBrush}" />

    <TitleBar x:Name="AppTitleBar" Title="AppBridge">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
      </TitleBar.IconSource>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
          <Button x:Name="AccountButton" x:Uid="TitleBar_Account" Style="{StaticResource TitleBarButtonStyle}" Click="OnAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE77B;" FontSize="14" />
              <TextBlock Text="{x:Bind ViewModel.Account.TitleBarText, Mode=OneWay}" FontSize="13" MaxWidth="220"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Uid="TitleBar_Settings" Style="{StaticResource TitleBarButtonStyle}" Click="OnSettingsClick">
            <FontIcon Glyph="&#xE713;" FontSize="15" />
          </Button>
        </StackPanel>
      </TitleBar.RightHeader>
    </TitleBar>

    <!-- Back and page dots -->
    <Grid Grid.Row="1" Height="44" Padding="14,0">
      <HyperlinkButton Visibility="{x:Bind ViewModel.ShowBack, Mode=OneWay}" Command="{x:Bind ViewModel.BackCommand}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE76B;" FontSize="12" />
          <TextBlock x:Uid="Footer_Back" Text="Back" FontSize="14" />
        </StackPanel>
      </HyperlinkButton>
      <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!-- Broken installation: ipatool missing -->
    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}" MaxWidth="600" Margin="24,0,24,12" Padding="16,12"
            Visibility="{x:Bind ViewModel.IsToolMissing}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource AppRedBrush}" VerticalAlignment="Center" />
        <TextBlock x:Uid="ToolMissing" Grid.Column="1" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center"
                   Text="A required component (ipatool) is missing, so apps can't be downloaded. Please reinstall AppBridge." />
      </Grid>
    </Border>

    <ContentControl x:Name="StepHost" Grid.Row="3" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTransitions>
        <TransitionCollection>
          <ContentThemeTransition HorizontalOffset="40" VerticalOffset="0" />
        </TransitionCollection>
      </ContentControl.ContentTransitions>
    </ContentControl>

    <!-- Footer -->
    <StackPanel Grid.Row="4" Padding="24,10,24,26" Spacing="10" HorizontalAlignment="Center">
      <TextBlock Style="{StaticResource FootnoteStyle}" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="{x:Bind ViewModel.FooterHint, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFooterHint, Mode=OneWay}" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <Button Style="{StaticResource SecondaryPillButtonStyle}" Content="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowSecondary, Mode=OneWay}" Command="{x:Bind ViewModel.SecondaryCommand}" />
        <Button x:Name="PrimaryButton" Style="{StaticResource PillButtonStyle}" Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowPrimary, Mode=OneWay}" Command="{x:Bind ViewModel.PrimaryCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
