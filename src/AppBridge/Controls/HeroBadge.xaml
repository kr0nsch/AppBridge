<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppBridge.Controls.HeroBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="112" Height="112">

  <!-- App-icon style hero: gradient squircle, white glyph, coloured glow, optional progress ring. -->
  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="PopScale" />
    </Grid.RenderTransform>

    <Ellipse x:Name="Glow" Width="104" Height="44" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.55" />

    <ProgressRing x:Name="Ring" Width="112" Height="112" MinWidth="112" MinHeight="112" IsIndeterminate="False"
                  Maximum="100" Visibility="Collapsed" IsActive="False" />

    <Border x:Name="Tile" Width="76" Height="76" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
        <!-- Soft sheen on the upper half, like the app icon. -->
        <Border CornerRadius="20">
          <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Offset="0" Color="#2EFFFFFF" />
              <GradientStop Offset="0.55" Color="#00FFFFFF" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <FontIcon x:Name="GlyphIcon" FontSize="34" Foreground="White" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
