<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppBridge.Controls.ChoiceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

  <!-- One choice on a start screen: tinted squircle, title, one-line explanation, chevron. -->
  <Button x:Name="RowButton" Style="{StaticResource ChoiceRowButtonStyle}" Click="OnClick">
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Tile" Width="42" Height="42" CornerRadius="11" VerticalAlignment="Center">
        <FontIcon x:Name="GlyphIcon" FontSize="20" Foreground="White" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="TitleText" Style="{StaticResource RowTitleStyle}" FontSize="15" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource FootnoteStyle}" FontSize="13" LineHeight="18" />
        <TextBlock x:Name="AccentSubtitleText" Style="{StaticResource FootnoteStyle}" FontSize="13" LineHeight="18"
                   Foreground="{ThemeResource AppBlueBrush}" Visibility="Collapsed" />
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource AppTertiaryLabelBrush}" VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
